# Copy to .env and fill in. .env is git-ignored — the key never leaves your machine/server.
# Any OpenRouter model id works (https://openrouter.ai/models). Free-tier examples:
#   nvidia/nemotron-3-super-120b-a12b:free
#   google/gemma-4-31b-it:free
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
PORT=8787
