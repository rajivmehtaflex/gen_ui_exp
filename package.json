{
  "name": "gen_ui_exp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Phase #1 hello-world self-hosted Generative UI app: AgentInterface + openuiChatLibrary + OpenRouter",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"npm run dev:server\" \"npm run dev:web\"",
    "dev:server": "node --env-file=.env --watch server/chat.mjs",
    "dev:web": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "gen:spec": "tsx scripts/gen-spec.ts",
    "check:spec": "tsx scripts/gen-spec.ts --check",
    "check:recipe": "node scripts/validate-recipe.mjs",
    "check:diagram": "node scripts/check-diagram.mjs",
    "check:examples": "node scripts/validate-examples.mjs",
    "test:library": "tsx scripts/test-library.mjs",
    "test:layout": "tsx scripts/test-diagram-layout.mjs",
    "test:tool": "node scripts/test-diagram-tool.mjs",
    "test:wire": "./node_modules/.bin/tsx scripts/test-tool-wire.mjs",
    "test:artifact": "./node_modules/.bin/tsx scripts/test-artifact-renderer.mjs",
    "test:input": "node scripts/test-chat-input.mjs",
    "test:loop": "node scripts/test-chat-loop.mjs",
    "test:process": "node scripts/test-process-runner.mjs",
    "test:store": "node scripts/test-artifact-store.mjs",
    "test:resource": "node scripts/test-resource-limits.mjs",
    "test:prompt": "node scripts/test-diagram-prompt.mjs",
    "test:routing": "node scripts/test-diagram-policy.mjs",
    "test:smoke-gates": "node scripts/test-smoke-gates.mjs",
    "test:error": "node scripts/test-error-visibility.mjs",
    "test:harness": "node scripts/test-harness.mjs",
    "test:browser": "node scripts/test-artifact-panel.mjs && node scripts/test-artifact-isolation.mjs && ./node_modules/.bin/tsx scripts/test-diagram-render.mjs",
    "verify": "node scripts/verify.mjs"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@openuidev/lang-core": "^0.3.0",
    "@openuidev/react-headless": "^0.16.3",
    "@openuidev/react-lang": "^0.3.0",
    "@openuidev/react-ui": "^0.16.3",
    "ajv": "^8.17.1",
    "express": "^4.21.2",
    "openai": "^4.85.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.25.0",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "playwright": "1.56.1",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3",
    "vite": "^6.0.11"
  }
}
